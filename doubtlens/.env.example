# ==============================================================================
# DoubtLens - Environment Configuration
# Hacktoberfest Hack Day Delhi x SKILLOP DTU Hackathon
# ==============================================================================

# Gemini API Key (Secret - NEVER commit real keys to git)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Model Identifier (Default: gemma-4-31b-it)
GEMMA_MODEL=gemma-4-31b-it

# Server Port (Default: 5000)
PORT=5000

# Mock Mode (1 = mock responses without calling Gemini API, 0 = live API calls)
# Set to 1 for offline testing, demos, or when developing without API quota
MOCK=1
